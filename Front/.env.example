# Copy this file to .env (never commit .env).

# Where the FastAPI backend lives. Leave EMPTY for local development: Vite then
# proxies /api to http://localhost:8000 (see vite.config.js), so there's no CORS setup.
# Set it only when the frontend and backend run on different hosts, e.g.
#   VITE_API_URL=http://192.168.1.20:8000
# and add this frontend's address to the backend's CORS_ORIGINS.
VITE_API_URL=
