<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ISU Infirmary — Patient Records & Logbook System</title>
<style>
  :root{
    --teal-900:#0b3d3a; --teal-700:#0f5e56; --teal-600:#137a6d; --teal-500:#1a9484;
    --teal-100:#e3f3ef; --teal-50:#f2f9f7;
    --ink:#12211f; --muted:#5c706c; --line:#e1e9e6; --bg:#f4f8f6;
    --amber:#b8790f; --amber-bg:#fdf3e2; --amber-line:#f0d9a8;
    --red:#b0332b; --red-bg:#fbeae8; --red-line:#f0c4c0;
    --green:#1f7a4d; --green-bg:#e6f5ec; --blue:#1d6fa5; --blue-bg:#eaf4fb;
    --font-display:"Iowan Old Style","Georgia",serif;
    --font-body:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
  }
  *{box-sizing:border-box;}
  body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--font-body);-webkit-font-smoothing:antialiased;}
  a{text-decoration:none;color:inherit;}

  /* ===== LOGIN ===== */
  #loginScreen{min-height:100vh;display:flex;align-items:center;justify-content:center;flex-direction:column;background:var(--bg);}
  .login-brand{text-align:center;margin-bottom:22px;}
  .login-brand .seal{width:56px;height:56px;border-radius:16px;background:var(--teal-600);margin:0 auto 14px;display:flex;align-items:center;justify-content:center;color:#fff;font-family:var(--font-display);font-weight:700;font-size:20px;}
  .login-brand h1{font-family:var(--font-display);font-size:24px;margin:0 0 4px;color:var(--ink);}
  .login-brand .s1{font-size:13px;color:var(--muted);margin-bottom:2px;}
  .login-brand .s2{font-size:11px;color:var(--muted);letter-spacing:1px;text-transform:uppercase;}
  .login-card{background:#fff;border-radius:14px;padding:26px;width:340px;box-shadow:0 6px 24px rgba(11,61,58,0.08);border:1px solid var(--line);}
  .login-card .lbl-top{font-size:11px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:0.5px;text-align:center;margin-bottom:12px;}
  .role-pick{display:flex;flex-direction:column;gap:10px;margin-bottom:16px;}
  .role-pick button{background:var(--teal-600);color:#fff;border:none;border-radius:10px;padding:12px;font-size:13.5px;font-weight:700;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:6px;transition:all 0.15s;}
  .role-pick button.sel{outline:2px solid var(--teal-900);outline-offset:2px;background:var(--teal-700);}
  .login-card label{font-size:10.5px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:0.4px;display:block;margin:12px 0 5px;}
  .login-card input{width:100%;border:1px solid var(--line);border-radius:8px;padding:9px 11px;font-size:13px;background:var(--teal-50);}
  .login-hint{font-size:10.5px;color:var(--muted);margin-top:6px;}
  .login-forgot{text-align:right;font-size:11px;color:var(--teal-700);font-weight:700;margin:8px 0;cursor:pointer;}
  .login-card .go{width:100%;background:var(--teal-600);color:#fff;border:none;border-radius:8px;padding:11px;font-size:13.5px;font-weight:700;cursor:pointer;margin-top:6px;}
  .login-foot{font-size:11px;color:var(--muted);margin-top:16px;}

  /* ===== APP SHELL ===== */
  #app{display:none;}
  #app.active{display:flex;min-height:100vh;}
  .sidebar{width:230px;background:#fff;border-right:1px solid var(--line);display:flex;flex-direction:column;padding:18px 14px;flex-shrink:0;}
  .sidebar .brand{display:flex;align-items:center;gap:10px;padding:6px 8px 14px;}
  .sidebar .brand .seal{width:32px;height:32px;border-radius:8px;background:var(--teal-600);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:12px;font-family:var(--font-display);}
  .sidebar .brand .txt div:first-child{font-weight:700;font-size:13px;}
  .sidebar .brand .txt div:last-child{font-size:10px;color:var(--muted);}
  .sidebar .user{display:flex;align-items:center;gap:10px;padding:8px;margin-bottom:10px;background:var(--teal-50);border-radius:8px;}
  .sidebar .user .av{width:28px;height:28px;border-radius:50%;background:var(--teal-100);color:var(--teal-700);display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;}
  .sidebar .user div div:first-child{font-size:12.5px;font-weight:600;}
  .sidebar .user div div:last-child{font-size:10.5px;color:var(--muted);}
  .nav{list-style:none;margin:0;padding:0;flex:1;}
  .nav li{margin-bottom:3px;}
  .nav a{display:flex;align-items:center;gap:10px;padding:9px 10px;border-radius:8px;font-size:13px;color:var(--muted);font-weight:500;cursor:pointer;transition:all 0.1s;}
  .nav a .ic{width:16px;text-align:center;font-size:13px;}
  .nav a.active{background:var(--teal-600);color:#fff;font-weight:600;}
  .nav a:not(.active):hover{background:var(--teal-50);color:var(--ink);}
  .signout{display:flex;align-items:center;gap:8px;padding:9px 10px;font-size:13px;color:var(--muted);cursor:pointer;border-top:1px solid var(--line);margin-top:auto;}

  .main{flex:1;display:flex;flex-direction:column;min-width:0;overflow-y:auto;}
  .topbar{display:flex;align-items:center;justify-content:space-between;padding:14px 26px;background:#fff;border-bottom:1px solid var(--line);}
  .topbar .crumb{font-size:13px;color:var(--muted);display:flex;align-items:center;gap:8px;}
  .topbar .icons{display:flex;align-items:center;gap:14px;font-size:14px;color:var(--muted);}
  .content{padding:22px 26px 60px;max-width:1380px;}
  .view{display:none;}
  .view.active{display:block;}
  .page-head{margin-bottom:18px;display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:12px;}
  .page-head h1{font-family:var(--font-display);font-size:22px;margin:0 0 4px;color:var(--teal-900);}
  .page-head .sub{font-size:12.5px;color:var(--muted);}

  .card{background:#fff;border:1px solid var(--line);border-radius:12px;padding:18px 20px;margin-bottom:16px;}
  .card h3{font-family:var(--font-display);font-size:15px;margin:0 0 12px;color:var(--teal-900);}

  /* Split layout for Visit Records + Today's Queue */
  .layout-split{display:grid;grid-template-columns:1fr 340px;gap:20px;align-items:start;}

  /* KPI */
  .kpi-row{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:16px;}
  .kpi{background:#fff;border:1px solid var(--line);border-radius:12px;padding:15px 16px;cursor:pointer;transition:box-shadow .15s,transform .15s;}
  .kpi:hover{box-shadow:0 4px 14px rgba(11,61,58,0.08);transform:translateY(-1px);}
  .kpi.primary{background:var(--teal-600);color:#fff;border-color:var(--teal-600);}
  .kpi .ic-badge{width:30px;height:30px;border-radius:8px;background:var(--teal-100);color:var(--teal-700);display:flex;align-items:center;justify-content:center;font-size:14px;margin-bottom:8px;}
  .kpi.primary .ic-badge{background:rgba(255,255,255,0.18);color:#fff;}
  .kpi.warn .ic-badge{background:var(--amber-bg);color:var(--amber);}
  .kpi.pending .ic-badge{background:var(--red-bg);color:var(--red);}
  .kpi .label{font-size:11px;text-transform:uppercase;letter-spacing:0.4px;font-weight:700;color:var(--muted);}
  .kpi.primary .label{color:rgba(255,255,255,0.75);}
  .kpi .value{font-family:var(--font-display);font-size:24px;font-weight:700;margin-top:6px;}
  .kpi.warn .value{color:var(--amber);}
  .kpi.pending .value{color:var(--red);}
  .kpi .foot{font-size:11px;color:var(--muted);margin-top:4px;}
  .kpi.primary .foot{color:rgba(255,255,255,0.75);}

  /* Range bar */
  .range-bar{display:flex;align-items:center;gap:10px;background:#fff;border:1px solid var(--line);border-radius:10px;padding:9px 12px;flex-wrap:wrap;margin-bottom:16px;}
  .range-bar .presets{display:flex;gap:4px;background:var(--teal-50);border-radius:7px;padding:3px;}
  .range-bar .presets button{border:none;background:transparent;padding:6px 11px;border-radius:5px;font-size:12px;font-weight:600;color:var(--muted);cursor:pointer;}
  .range-bar .presets button.active{background:var(--teal-600);color:#fff;}
  .range-bar select{border:1px solid var(--line);border-radius:6px;padding:6px 9px;font-size:12.5px;}
  .range-bar .live-note{font-size:11px;color:var(--teal-700);display:flex;align-items:center;gap:5px;margin-left:auto;}
  .range-bar .live-note .dot{width:6px;height:6px;border-radius:50%;background:var(--teal-500);animation:pulse 1.8s infinite;}
  @keyframes pulse{0%,100%{opacity:1;}50%{opacity:0.3;}}

  .alert-banner{background:var(--amber-bg);border:1px solid var(--amber-line);border-radius:10px;padding:12px 16px;display:flex;align-items:center;gap:12px;margin-bottom:16px;}
  .alert-banner .ic{color:var(--amber);font-size:16px;}
  .alert-banner .txt strong{font-size:12.5px;color:#8a5c0a;display:block;}
  .alert-banner .txt span{font-size:11.5px;color:#8a5c0a;opacity:0.85;}
  .alert-banner .go{margin-left:auto;background:#fff;border:1px solid var(--amber-line);color:#8a5c0a;border-radius:6px;padding:6px 12px;font-size:11.5px;font-weight:700;cursor:pointer;white-space:nowrap;}

  .bars{display:flex;align-items:flex-end;gap:14px;height:150px;padding-top:8px;}
  .bars .bar-col{flex:1;display:flex;flex-direction:column;align-items:center;gap:6px;height:100%;justify-content:flex-end;}
  .bars .bar{width:60%;background:var(--teal-600);border-radius:4px 4px 0 0;}
  .bars .bar-col .num{font-size:10px;color:var(--muted);font-weight:600;}
  .bars .bar-col .lbl{font-size:10.5px;color:var(--muted);}

  .chart-row{display:grid;grid-template-columns:1.5fr 1fr;gap:14px;}
  .donut-wrap{display:flex;align-items:center;gap:18px;}
  .donut-legend{display:flex;flex-direction:column;gap:9px;flex:1;}
  .legend-row{display:flex;align-items:center;gap:8px;font-size:12px;}
  .legend-row .sw{width:9px;height:9px;border-radius:50%;flex-shrink:0;}
  .legend-row .pct{margin-left:auto;font-weight:700;}
  .legend-row .name{color:var(--muted);}

  /* Tables */
  table{width:100%;border-collapse:collapse;font-size:12.5px;}
  th{text-align:left;font-size:10.5px;text-transform:uppercase;letter-spacing:0.4px;color:var(--muted);font-weight:700;padding:8px 10px;border-bottom:1px solid var(--line);}
  td{padding:11px 10px;border-bottom:1px solid var(--line);}
  tr:last-child td{border-bottom:none;}
  tr.rowlink{cursor:pointer;}
  tr.rowlink:hover{background:var(--teal-50);}
  .nm{font-weight:600;color:var(--ink);}
  .sub{font-size:11px;color:var(--muted);}
  
  /* Badges & Tags */
  .pill{font-size:10px;font-weight:700;padding:3px 9px;border-radius:20px;text-transform:uppercase;display:inline-block;}
  .pill.high-stock{background:var(--green-bg);color:var(--green);}
  .pill.low-stock{background:var(--amber-bg);color:var(--amber);}
  .pill.out-stock{background:var(--red-bg);color:var(--red);}
  .pill.pwd-badge{background:var(--teal-100);color:var(--teal-700);font-size:9.5px;padding:2px 6px;border-radius:12px;font-weight:700;display:inline-flex;align-items:center;gap:3px;margin-left:4px;}
  .pill.senior-badge{background:var(--blue-bg);color:var(--blue);font-size:9.5px;padding:2px 6px;border-radius:12px;font-weight:700;display:inline-flex;align-items:center;gap:3px;margin-left:4px;}
  .flag-tag-red{background:#fff;border:1px solid var(--red-line);color:#8a2a24;font-size:10.5px;font-weight:700;padding:3px 9px;border-radius:20px;display:inline-block;}
  .pill.active{background:var(--green-bg);color:var(--green);}
  .pill.inactive{background:var(--red-bg);color:var(--red);}
  .pill.pending{background:var(--amber-bg);color:var(--amber);}

  .toolbar{display:flex;gap:10px;align-items:center;margin-bottom:14px;flex-wrap:wrap;}
  .toolbar input[type=text], .toolbar input[type=date], .toolbar select{border:1px solid var(--line);border-radius:8px;padding:8px 11px;font-size:12.5px;}
  .toolbar input[type=text]{flex:1;min-width:200px;}
  th.sortable{cursor:pointer;user-select:none;}
  th.sortable:hover{color:var(--teal-700);}
  .sort-ic{font-size:9px;opacity:0.6;}
  .pagination-bar{display:flex;justify-content:space-between;align-items:center;margin-top:12px;font-size:12.5px;color:var(--muted);padding:8px 4px;}
  .pg-size select{border:1px solid var(--line);border-radius:6px;padding:4px 8px;font-size:12px;margin:0 4px;}
  .pg-nav{display:flex;align-items:center;gap:8px;}
  .pg-nav button{background:#fff;border:1px solid var(--line);border-radius:6px;padding:5px 10px;font-size:12px;cursor:pointer;color:var(--ink);}
  .pg-nav button:hover{background:var(--teal-50);}
  .pg-current{font-weight:700;color:var(--teal-700);padding:0 4px;}
  .tabs{display:flex;gap:8px;margin-bottom:14px;}
  .tabs button{flex:1;background:#fff;border:1px solid var(--line);border-radius:8px;padding:9px;font-size:12.5px;font-weight:700;color:var(--muted);cursor:pointer;}
  .tabs button.active{background:var(--teal-600);color:#fff;border-color:var(--teal-600);}

  .btn{border:none;border-radius:8px;padding:10px 16px;font-size:13px;font-weight:600;cursor:pointer;font-family:var(--font-body);display:inline-flex;align-items:center;justify-content:center;gap:6px;}
  .btn-primary{background:var(--teal-600);color:#fff;}
  .btn-primary:hover{background:var(--teal-700);}
  .btn-ghost{background:transparent;border:1px solid var(--line);color:var(--ink);}
  .btn-outline{background:#fff;border:1px solid var(--teal-500);color:var(--teal-700);}
  .btn-danger{background:var(--red);color:#fff;}
  .btn-sm{padding:6px 12px;font-size:11.5px;}

  /* Forms & Search */
  .field-row{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:14px;}
  .field-row.three{grid-template-columns:1fr 1fr 1fr;}
  .field{display:flex;flex-direction:column;gap:5px;}
  .field.full{grid-column:1/-1;}
  .field label{font-size:11px;font-weight:700;color:var(--teal-700);text-transform:uppercase;letter-spacing:0.4px;}
  .field .opt{font-weight:400;color:var(--muted);text-transform:none;letter-spacing:0;}
  input[type=text],input[type=date],input[type=number],select,textarea{border:1px solid var(--line);border-radius:8px;padding:9px 11px;font-size:13px;font-family:var(--font-body);color:var(--ink);background:#fff;width:100%;}
  textarea{resize:vertical;min-height:56px;}
  input:focus,select:focus,textarea:focus{outline:none;border-color:var(--teal-500);box-shadow:0 0 0 3px rgba(26,148,132,0.15);}
  input[readonly]{background:var(--teal-50);color:var(--muted);}
  .segmented{display:flex;border:1px solid var(--line);border-radius:8px;overflow:hidden;margin-bottom:14px;}
  .segmented button{flex:1;border:none;background:#fff;padding:9px 6px;font-size:12.5px;font-weight:600;color:var(--muted);cursor:pointer;border-right:1px solid var(--line);}
  .segmented button:last-child{border-right:none;}
  .segmented button.active{background:var(--teal-600);color:#fff;}
  .checkbox-row{display:flex;gap:14px;flex-wrap:wrap;}
  .checkbox-row label{display:flex;align-items:center;gap:6px;font-size:12.5px;color:var(--ink);font-weight:500;cursor:pointer;text-transform:none;letter-spacing:0;}

  .roster-search{position:relative;margin-bottom:10px;}
  .roster-search input{padding-left:34px;height:42px;}
  .roster-search .ic{position:absolute;left:11px;top:50%;transform:translateY(-50%);color:var(--muted);font-size:14px;}
  .roster-results{border:1px solid var(--line);border-radius:8px;overflow:hidden;background:#fff;margin-bottom:14px;}
  .roster-row{display:flex;justify-content:space-between;align-items:center;padding:9px 12px;border-bottom:1px solid var(--line);font-size:12.5px;}
  .roster-row:last-child{border-bottom:none;}
  .roster-row:hover{background:var(--teal-50);}

  /* Side panel Today's visits */
  .today-panel{background:#fff;border:1px solid var(--line);border-radius:12px;padding:16px;}
  .today-panel-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;padding-bottom:10px;border-bottom:1px solid var(--line);}
  .today-panel-head h3{font-family:var(--font-display);font-size:16px;margin:0;color:var(--teal-900);}
  .today-panel-head span{font-size:11px;color:var(--muted);}
  .visit-mini-card{border:1px solid var(--line);border-radius:10px;padding:12px;margin-bottom:10px;background:var(--teal-50);}
  .visit-mini-card .top{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:4px;}
  .visit-mini-card .name{font-weight:700;font-size:13px;color:var(--ink);}
  .visit-mini-card .meta{font-size:11px;color:var(--muted);margin-bottom:6px;}
  .visit-mini-card .diag{font-size:11.5px;color:var(--ink);margin-bottom:8px;line-height:1.4;}
  .visit-mini-card .actions{display:flex;justify-content:space-between;align-items:center;font-size:11px;}

  /* Modal */
  .modal-backdrop{position:fixed;inset:0;background:rgba(11,61,58,0.45);display:none;align-items:center;justify-content:center;z-index:50;padding:20px;}
  .modal-backdrop.open{display:flex;}
  .modal{background:#fff;border-radius:14px;padding:0;width:520px;max-width:100%;max-height:92vh;overflow-y:auto;box-shadow:0 10px 30px rgba(0,0,0,0.15);}
  .modal.wide{width:620px;}
  .modal-head{padding:18px 22px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;}
  .modal-head h3{font-family:var(--font-display);margin:0;font-size:16px;color:var(--teal-900);}
  .modal-head .sub{font-size:11.5px;color:var(--muted);margin-top:2px;}
  .modal-close{background:none;border:none;font-size:16px;color:var(--muted);cursor:pointer;}
  .modal-body{padding:20px 22px;}
  .modal-actions{display:flex;gap:10px;justify-content:flex-end;padding:14px 22px;border-top:1px solid var(--line);background:#fafdfc;}

  .settings-row{display:flex;justify-content:space-between;align-items:center;padding:12px 0;border-bottom:1px solid var(--line);}
  .settings-row:last-child{border-bottom:none;}
  .settings-row .t{font-size:13px;font-weight:600;}
  .settings-row .d{font-size:11.5px;color:var(--muted);margin-top:2px;}
  .toggle{width:40px;height:22px;border-radius:20px;background:var(--line);position:relative;cursor:pointer;flex-shrink:0;}
  .toggle.on{background:var(--teal-600);}
  .toggle .knob{width:16px;height:16px;border-radius:50%;background:#fff;position:absolute;top:3px;left:3px;transition:left .15s;}
  .toggle.on .knob{left:21px;}

  @media(max-width:1080px){.layout-split{grid-template-columns:1fr;}.kpi-row{grid-template-columns:repeat(2,1fr);}}
</style>
</head>
<body>

<!-- ============================= LOGIN ============================= -->
<div id="loginScreen">
  <div class="login-brand">
    <div class="seal">ISU</div>
    <h1>ISU Infirmary</h1>
    <div class="s1">Infirmary Log Book System</div>
    <div class="s2">Isabela State University</div>
  </div>
  <div class="login-card">
    <div class="lbl-top">Sign in as</div>
    <div class="role-pick">
      <button class="sel" id="pickNurse" onclick="pickRole('nurse')">🛡 Nurse / Staff</button>
      <button id="pickAdmin" onclick="pickRole('admin')">👥 Admin</button>
    </div>
    <label>Username</label>
    <input type="text" id="loginUser" placeholder="e.g. nsantos" value="nsantos">
    <label>Password</label>
    <input type="password" placeholder="••••••••" value="password123!">
    <div class="login-hint">Minimum 8 characters, at least 1 symbol.</div>
    <div class="login-forgot" onclick="openModal('forgotModal')">Forgot Password?</div>
    <button class="go" onclick="login()">Sign In</button>
  </div>
  <div class="login-foot">ISU Infirmary Log Book System · 2026 Formalized</div>
</div>

<!-- ============================= APP SHELL ============================= -->
<div id="app">
  <div class="sidebar">
    <div class="brand">
      <div class="seal">ISU</div>
      <div class="txt"><div>ISU Infirmary</div><div>Log Book System</div></div>
    </div>
    <div class="user">
      <div class="av" id="userAv">NS</div>
      <div><div id="userName">Nurse Santos</div><div id="userRole">Nurse</div></div>
    </div>
    <ul class="nav" id="navList"></ul>
    <div class="signout" onclick="logout()">⏻ Sign Out</div>
  </div>

  <div class="main">
    <div class="topbar">
      <div class="crumb" id="crumbTxt">☰ Dashboard</div>
      <div class="icons"><span>🔔</span><span id="topRolePill">👤 Nurse</span></div>
    </div>

    <div class="content">

      <!-- ========================================================= -->
      <!-- NURSE VIEWS                                              -->
      <!-- ========================================================= -->

      <!-- Nurse Dashboard -->
      <div class="view" id="view-nurse-dash">
