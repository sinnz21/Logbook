      <div class="field full"><label>Email</label><input type="text" placeholder="e.g. cgaffud@isu.edu.ph"></div>
    </div>
    <div class="modal-actions">
      <button class="btn btn-ghost" onclick="closeModal('addUserModal')">Cancel</button>
      <button class="btn btn-primary" onclick="closeModal('addUserModal');alert('User account created.')">Create User</button>
    </div>
  </div>
</div>

<script>
  let currentRole = 'nurse';

  const NAVS = {
    nurse: [
      {id:"view-nurse-dash", ic:"▦", label:"Dashboard"},
      {id:"view-visit-hub", ic:"▤", label:"Visit Records"},
      {id:"view-flag-cases", ic:"🚩", label:"Priority & Special Cases"},
      {id:"view-stock", ic:"⚕", label:"Stock & Supplies"},
      {id:"view-insights", ic:"📈", label:"Reports & Insights"},
    ],
    admin: [
      {id:"view-admin-dash", ic:"▦", label:"Dashboard"},
      {id:"view-users", ic:"👥", label:"User Management"},
      {id:"view-settings", ic:"⚙", label:"Settings"},
    ]
  };

  function buildNav(role){
    const list = document.getElementById('navList');
    list.innerHTML = NAVS[role].map((item,i) => `<li><a class="${i===0?'active':''}" onclick="showView('${item.id}', this)"><span class="ic">${item.ic}</span>${item.label}</a></li>`).join('');
  }

  function pickRole(role){
    currentRole = role;
    document.getElementById('pickAdmin').classList.toggle('sel', role==='admin');
    document.getElementById('pickNurse').classList.toggle('sel', role==='nurse');
    document.getElementById('loginUser').value = role === 'admin' ? 'acruz' : 'nsantos';
  }

  function login(){
    document.getElementById('loginScreen').style.display = 'none';
    document.getElementById('app').classList.add('active');
    buildNav(currentRole);
    if(currentRole === 'admin'){
      document.getElementById('userAv').textContent = 'AD';
      document.getElementById('userName').textContent = 'Admin Cruz';
      document.getElementById('userRole').textContent = 'Admin';
      document.getElementById('topRolePill').textContent = '👤 Admin';
      showView('view-admin-dash');
    } else {
      document.getElementById('userAv').textContent = 'NS';
      document.getElementById('userName').textContent = 'Nurse Santos';
      document.getElementById('userRole').textContent = 'Nurse';
      document.getElementById('topRolePill').textContent = '👤 Nurse';
      showView('view-nurse-dash');
    }
  }

  function logout(){
    document.getElementById('app').classList.remove('active');
    document.getElementById('loginScreen').style.display = 'flex';
  }

  function showView(id, el){
    document.querySelectorAll('.view').forEach(v=>v.classList.remove('active'));
    const target = document.getElementById(id);
    if(target) target.classList.add('active');
    
    document.querySelectorAll('.nav a').forEach(a=>a.classList.remove('active'));
    if(el) el.classList.add('active');
    else {
      const links = NAVS[currentRole];
      const idx = links.findIndex(l=>l.id===id);
      if(idx >= 0) {
        const item = document.querySelectorAll('.nav a')[idx];
        if(item) item.classList.add('active');
      }
    }
    const found = NAVS[currentRole].find(l=>l.id===id);
    document.getElementById('crumbTxt').textContent = found ? found.label : 'Infirmary Portal';
  }

  function openModal(id){ const el = document.getElementById(id); if(el) el.classList.add('open'); }
  function closeModal(id){ const el = document.getElementById(id); if(el) el.classList.remove('open'); }

  // Restock Approval Flow
  function resolveRestock(btn, action){
    const row = btn.closest('tr');
    row.style.opacity = '0.4';
    row.innerHTML = `<td colspan="6" style="text-align:center;color:var(--teal-700);font-weight:700;">Request has been ${action}</td>`;
    setTimeout(()=>{
      row.remove();
      const count = document.querySelectorAll('#restockReqList tr').length;
      document.getElementById('adminReqCount').textContent = count;
    }, 1200);
  }

  // Stock Filter by High/Low/Out
  function filterStockStatus(btn, status){
    document.querySelectorAll('#view-stock .tabs button').forEach(b=>b.classList.remove('active'));
    btn.classList.add('active');
    document.querySelectorAll('#nurseStockTable tbody tr').forEach(row=>{
      row.style.display = (status === 'all' || row.dataset.status === status) ? '' : 'none';
    });
  }

  function filterStockSearch(){
    const q = document.getElementById('stockSearchInput').value.toLowerCase();
    const cat = document.getElementById('stockCatSelect').value;
    document.querySelectorAll('#nurseStockTable tbody tr').forEach(row=>{
      const matchesQ = row.innerText.toLowerCase().includes(q);
      const matchesCat = (cat === 'all' || row.dataset.cat === cat);
      row.style.display = (matchesQ && matchesCat) ? '' : 'none';
    });
  }

  // Flag Cases Filters
  function filterFlagCategory(btn, cat){
    document.querySelectorAll('#view-flag-cases .tabs button').forEach(b=>b.classList.remove('active'));
    btn.classList.add('active');
    document.querySelectorAll('#flagsTableBody tr').forEach(row=>{
      row.style.display = (cat === 'all' || row.dataset.cat === cat) ? '' : 'none';
    });
  }

  function filterFlags(){
    const q = document.getElementById('flagSearchInput').value.toLowerCase();
    document.querySelectorAll('#flagsTableBody tr').forEach(row=>{
      row.style.display = row.innerText.toLowerCase().includes(q) ? '' : 'none';
    });
  }

  function autofillAddDemo(){
    document.getElementById('addFn').value = "CJ";
    document.getElementById('addLn').value = "GAFFUD";
    document.getElementById('addId').value = "24-2133";
  }

  function pickSegVisitor(btn, type){
    btn.parentElement.querySelectorAll('button').forEach(b=>b.classList.remove('active'));
    btn.classList.add('active');
  }
</script>

</body>
</html>
